root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.cs]
indent_size = 4
charset = utf-8-bom

# .NET naming rules
dotnet_naming_rule.interface_should_be_ipascal.importance = high
dotnet_naming_rule.interface_should_be_ipascal.severity = error
dotnet_naming_rule.interface_should_be_ipascal.style = ipascal
dotnet_naming_rule.interface_should_be_ipascal.symbols = interface
dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_style.ipascal.required_prefix = I
dotnet_naming_style.ipascal.capitalization = pascal_case

dotnet_naming_rule.types_should_be_pascal.importance = high
dotnet_naming_rule.types_should_be_pascal.severity = error
dotnet_naming_rule.types_should_be_pascal.style = pascal
dotnet_naming_rule.types_should_be_pascal.symbols = types
dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, record
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.public_members_should_be_pascal.importance = high
dotnet_naming_rule.public_members_should_be_pascal.severity = error
dotnet_naming_rule.public_members_should_be_pascal.style = pascal
dotnet_naming_rule.public_members_should_be_pascal.symbols = public_members
dotnet_naming_symbols.public_members.applicable_accessibilities = public, internal
dotnet_naming_symbols.public_members.applicable_kinds = method, property, event, field

dotnet_naming_style.camel.capitalization = camel_case

# .NET code style rules
dotnet_style_readonly_field = true:error
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error
dotnet_style_prefer_auto_properties = true:error
dotnet_style_object_initializer = true:error
dotnet_style_collection_initializer = true:error
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:error
dotnet_style_prefer_conditional_expression_over_assignment = false:none
dotnet_style_prefer_conditional_expression_over_return = false:none

# C# code style rules
csharp_style_expression_bodied_methods = true:error
csharp_style_expression_bodied_constructors = true:error
csharp_style_expression_bodied_properties = true:error
csharp_style_expression_bodied_indexers = true:error
csharp_style_expression_bodied_accessors = true:error
csharp_style_expression_bodied_lambdas = true:error
csharp_style_expression_bodied_local_functions = false:none
csharp_style_var_for_built_in_types = false:none
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:none
csharp_prefer_simple_default_expression = true:error
csharp_prefer_static_local_function = true:suggestion
csharp_preferred_modifier_order = public, private, protected, internal, static, extern, new, virtual, abstract, sealed, override, readonly, unsafe, required, file:error
csharp_style_prefer_pattern_matching = true:error
csharp_style_prefer_not_pattern = true:error
csharp_style_prefer_extreme_program_checks = true:none

# C# formatting rules — Allman brace style (brace on new line)
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

# DevelopmentDemoSalonSeeder uses record primary constructor params as local seed data;
# suppress naming rule IDE1006 to avoid conflicts with record auto-property conventions.
[backend/src/Tailbook.Api.Host/Infrastructure/DevelopmentDemoSalonSeeder.cs]
dotnet_naming_rule.public_members_should_be_pascal.severity = none
dotnet_naming_rule.interface_should_be_ipascal.severity = none

[*.{json,yml,yaml,md}]
indent_size = 2
